{
  "info": {"name": "Rice Duck DSS - Model A", "description": "Run Model A cases and authenticated v4 history in order.", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "event": [
    {"listen": "prerequest", "script": {"type": "text/javascript", "exec": ["if (pm.info.requestName === 'Register') pm.environment.set('user_email', `model_a_${Date.now()}@example.com`);"]}},
    {"listen": "test", "script": {"type": "text/javascript", "exec": ["const body = pm.response.json();", "const name = pm.info.requestName;", "if (name === 'Register') pm.expect(pm.response.code).to.eql(201);", "if (name === 'Login') { pm.expect(pm.response.code).to.eql(200); pm.environment.set('access_token', body.access_token); }", "if (name === 'No duration abstains') { pm.expect(body.yield_status).to.eql('OUTSIDE_LITERATURE_DOMAIN'); pm.expect(body.yield_are_kg).to.eql(null); pm.expect(body.provenance.prices.p_gabah).to.include('local-estimate fallback'); pm.expect(body.provenance.prices.p_duck_buy).to.include('local-estimate fallback'); pm.expect(body.provenance.prices.p_duck_sell).to.include('local-estimate fallback'); }", "if (name === 'Xiong t=49 outside' || name === 'Xiong t=81 outside') { pm.expect(body.yield_status).to.eql('OUTSIDE_LITERATURE_DOMAIN'); pm.expect(body.yield_total_kg).to.eql(null); }", "if (name === 'S-A14 Xiong t=50') { pm.expect(body.yield_status).to.eql('VALID'); pm.expect(body.yield_are_kg).to.be.closeTo(65.0044549762, 1e-8); pm.expect(body.cash_contribution_before_optional).to.be.closeTo(4700267.30, 0.02); }", "if (name === 'Xiong t=80 valid') { pm.expect(body.yield_status).to.eql('VALID'); pm.expect(body.yield_are_kg).to.be.closeTo(69.7396, 1e-8); }", "if (name === 'Density exactly 8') { pm.expect(body.density_status).to.eql('WARNING_ABOVE_RECOMMENDED'); pm.expect(body.survival_risk).to.eql(null); }", "if (name === 'Density above 8') { pm.expect(body.density_status).to.eql('HIGH_RISK'); pm.expect(body.survival_risk).to.eql('HIGH'); pm.expect(body.revenue_duck_all_sold_scenario).to.eql(null); }", "if (name === 'J=0 accepted') { pm.expect(body.density_are).to.eql(0); pm.expect(body.density_status).to.eql('UNDER'); pm.expect(body.cost_duck_buy).to.eql(0); }", "if (name === 'Optional date and runtime prices') { pm.expect(body.release_date_min).to.eql('2026-01-22'); pm.expect(body.withdraw_date_max).to.eql('2026-03-02'); pm.expect(body.provenance.prices).to.eql({p_gabah: 'runtime', p_duck_buy: 'runtime', p_duck_sell: 'runtime'}); }", "if (name === 'Invalid infrastructure pair') pm.expect(pm.response.code).to.eql(400);", "if (name === 'Simulate v4') pm.environment.set('simulation_response', JSON.stringify(body));", "if (name === 'List v4 histories') { pm.expect(body.data[0].schema_version).to.eql(4); pm.environment.set('history_id', body.data[0].id); }", "if (name === 'Get exact v4 detail') pm.expect(body).to.eql(JSON.parse(pm.environment.get('simulation_response')));", "if (name === 'Get deleted v4 history') pm.expect(pm.response.code).to.eql(404);"]}}
  ],
  "item": [
    {"name": "Model A cases", "item": [
      {"name": "No duration abstains", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"land_area_are\":10,\"duck_count\":40,\"rice_variety\":\"sertani\",\"planting_system\":\"jajar_legowo\",\"duck_age_days\":21}"}, "url": "{{base_url}}/api/v1/dss/simulate"}},
      {"name": "Xiong t=49 outside", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"land_area_are\":10,\"duck_count\":40,\"rice_variety\":\"sertani\",\"planting_system\":\"jajar_legowo\",\"duck_age_days\":21,\"literature_duration_days\":49}"}, "url": "{{base_url}}/api/v1/dss/simulate"}},
      {"name": "S-A14 Xiong t=50", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"land_area_are\":10,\"duck_count\":40,\"rice_variety\":\"sertani\",\"planting_system\":\"jajar_legowo\",\"duck_age_days\":21,\"literature_duration_days\":50,\"p_gabah\":6000,\"p_duck_buy\":25000,\"p_duck_sell\":45000}"}, "url": "{{base_url}}/api/v1/dss/simulate"}},
      {"name": "Xiong t=80 valid", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"land_area_are\":10,\"duck_count\":40,\"rice_variety\":\"sertani\",\"planting_system\":\"jajar_legowo\",\"duck_age_days\":21,\"literature_duration_days\":80}"}, "url": "{{base_url}}/api/v1/dss/simulate"}},
      {"name": "Xiong t=81 outside", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"land_area_are\":10,\"duck_count\":40,\"rice_variety\":\"sertani\",\"planting_system\":\"jajar_legowo\",\"duck_age_days\":21,\"literature_duration_days\":81}"}, "url": "{{base_url}}/api/v1/dss/simulate"}},
      {"name": "Density exactly 8", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"land_area_are\":10,\"duck_count\":80,\"rice_variety\":\"sertani\",\"planting_system\":\"jajar_legowo\",\"duck_age_days\":21}"}, "url": "{{base_url}}/api/v1/dss/simulate"}},
      {"name": "Density above 8", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"land_area_are\":10,\"duck_count\":81,\"rice_variety\":\"sertani\",\"planting_system\":\"jajar_legowo\",\"duck_age_days\":21}"}, "url": "{{base_url}}/api/v1/dss/simulate"}},
      {"name": "J=0 accepted", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"land_area_are\":10,\"duck_count\":0,\"rice_variety\":\"sertani\",\"planting_system\":\"jajar_legowo\",\"duck_age_days\":21}"}, "url": "{{base_url}}/api/v1/dss/simulate"}},
      {"name": "Optional date and runtime prices", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"land_area_are\":10,\"duck_count\":40,\"rice_variety\":\"sertani\",\"planting_system\":\"jajar_legowo\",\"duck_age_days\":21,\"planting_date\":\"2026-01-01\",\"p_gabah\":7000,\"p_duck_buy\":26000,\"p_duck_sell\":46000}"}, "url": "{{base_url}}/api/v1/dss/simulate"}},
      {"name": "Invalid infrastructure pair", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"land_area_are\":10,\"duck_count\":40,\"rice_variety\":\"sertani\",\"planting_system\":\"jajar_legowo\",\"duck_age_days\":21,\"c_jaring_purchase\":100}"}, "url": "{{base_url}}/api/v1/dss/simulate"}}
    ]},
    {"name": "Authenticated v4 history", "item": [
      {"name": "Register", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"name\":\"{{user_name}}\",\"email\":\"{{user_email}}\",\"password\":\"{{user_password}}\"}"}, "url": "{{base_url}}/api/v1/auth/register"}},
      {"name": "Login", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"email\":\"{{user_email}}\",\"password\":\"{{user_password}}\"}"}, "url": "{{base_url}}/api/v1/auth/login"}},
      {"name": "Simulate v4", "request": {"method": "POST", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{access_token}}", "type": "string"}]}, "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"land_area_are\":10,\"duck_count\":40,\"rice_variety\":\"sertani\",\"planting_system\":\"jajar_legowo\",\"duck_age_days\":21,\"literature_duration_days\":50}"}, "url": "{{base_url}}/api/v1/dss/simulate"}},
      {"name": "List v4 histories", "request": {"method": "GET", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{access_token}}", "type": "string"}]}, "url": "{{base_url}}/api/v1/dss/histories"}},
      {"name": "Get exact v4 detail", "request": {"method": "GET", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{access_token}}", "type": "string"}]}, "url": "{{base_url}}/api/v1/dss/histories/{{history_id}}"}},
      {"name": "Delete v4 history", "request": {"method": "DELETE", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{access_token}}", "type": "string"}]}, "url": "{{base_url}}/api/v1/dss/histories/{{history_id}}"}},
      {"name": "Get deleted v4 history", "request": {"method": "GET", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{access_token}}", "type": "string"}]}, "url": "{{base_url}}/api/v1/dss/histories/{{history_id}}"}}
    ]}
  ],
  "variable": [{"key": "base_url", "value": "http://127.0.0.1:8000"}]
}
