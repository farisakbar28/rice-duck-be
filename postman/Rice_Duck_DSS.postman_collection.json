      {"name": "S-C08 age 20 lower boundary", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["const b=pm.response.json(); pm.test('S-C08 age 20',()=>{pm.response.to.have.status(200); pm.expect(b.yield_are_kg).eq(50); pm.expect(b.age_status).eq('NOT_RECOMMENDED');});"]}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"land_area_are\":10,\"duck_count\":20,\"rice_variety\":\"sertani\",\"planting_system\":\"jajar_legowo\",\"duck_age_days\":20}"}, "url": "{{base_url}}/api/v1/dss/simulate"}},
      {"name": "S-C08 age 21 recommended boundary", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["const b=pm.response.json(); pm.test('S-C08 age 21',()=>{pm.response.to.have.status(200); pm.expect(b.yield_are_kg).eq(50); pm.expect(b.age_status).eq('LOCAL_READY');});"]}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"land_area_are\":10,\"duck_count\":20,\"rice_variety\":\"sertani\",\"planting_system\":\"jajar_legowo\",\"duck_age_days\":21}"}, "url": "{{base_url}}/api/v1/dss/simulate"}},
