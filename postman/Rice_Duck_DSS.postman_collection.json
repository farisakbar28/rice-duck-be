      {"name": "S-C08 age 31 upper boundary", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["const b=pm.response.json(); pm.test('S-C08 age 31',()=>{pm.response.to.have.status(200); pm.expect(b.yield_are_kg).eq(50); pm.expect(b.age_status).eq('OLDER_CONSERVATIVE');});"]}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"land_area_are\":10,\"duck_count\":20,\"rice_variety\":\"sertani\",\"planting_system\":\"jajar_legowo\",\"duck_age_days\":31}"}, "url": "{{base_url}}/api/v1/dss/simulate"}},
      {"name": "S-C09 golden default prices", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["const b=pm.response.json(); pm.test('S-C09',()=>{pm.response.to.have.status(200); pm.expect(b.model_variant).eq('C_FARMER_GROUPED_LOCAL'); pm.expect(b.yield_are_kg).eq(50); pm.expect(b.yield_total_kg).eq(500); pm.expect(b.revenue_gabah).eq(3000000); pm.expect(b.revenue_duck_all_sold_scenario).eq(900000); pm.expect(b.cost_duck_buy).eq(500000); pm.expect(b.cash_contribution_before_optional).eq(3400000); pm.expect(b.provenance.prices.p_gabah.value).eq(6000); pm.expect(b.provenance.prices.p_duck_buy.value).eq(25000); pm.expect(b.provenance.prices.p_duck_sell.value).eq(45000); pm.expect(b.provenance.prices.p_gabah.status).eq('local-calibrated'); pm.expect(b.provenance.prices.p_duck_buy.status).eq('local-calibrated'); pm.expect(b.provenance.prices.p_duck_sell.status).eq('local-estimate');});"]}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"land_area_are\":10,\"duck_count\":20,\"rice_variety\":\"sertani\",\"planting_system\":\"jajar_legowo\",\"duck_age_days\":21}"}, "url": "{{base_url}}/api/v1/dss/simulate"}},
      {"name": "Runtime duck-buy override", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["const b=pm.response.json(); pm.test('runtime duck-buy override',()=>{pm.response.to.have.status(200); pm.expect(b.cost_duck_buy).eq(520000); pm.expect(b.provenance.prices.p_duck_buy.source).eq('runtime'); pm.expect(b.provenance.prices.p_duck_buy.status).eq('runtime');});"]}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"land_area_are\":10,\"duck_count\":20,\"rice_variety\":\"sertani\",\"planting_system\":\"jajar_legowo\",\"duck_age_days\":21,\"p_duck_buy\":26000}"}, "url": "{{base_url}}/api/v1/dss/simulate"}},
      {"name": "Runtime duck-buy zero", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["const b=pm.response.json(); pm.test('runtime duck-buy zero',()=>{pm.response.to.have.status(200); pm.expect(b.cost_duck_buy).eq(0); pm.expect(b.provenance.prices.p_duck_buy.value).eq(0); pm.expect(b.provenance.prices.p_duck_buy.source).eq('runtime'); pm.expect(b.provenance.prices.p_duck_buy.status).eq('runtime');});"]}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"land_area_are\":10,\"duck_count\":20,\"rice_variety\":\"sertani\",\"planting_system\":\"jajar_legowo\",\"duck_age_days\":21,\"p_duck_buy\":0}"}, "url": "{{base_url}}/api/v1/dss/simulate"}},
      {"name": "S-C10 optional costs omitted", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["const b=pm.response.json(); pm.test('S-C10',()=>{pm.response.to.have.status(200); pm.expect(b.cost_feed_scenario).eq(null); pm.expect(b.cost_infra_cycle).eq(null); pm.expect(b.cash_contribution_after_optional).eq(null); pm.expect(b.cash_contribution_before_optional).eq(3400000);});"]}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"land_area_are\":10,\"duck_count\":20,\"rice_variety\":\"sertani\",\"planting_system\":\"jajar_legowo\",\"duck_age_days\":21}"}, "url": "{{base_url}}/api/v1/dss/simulate"}},
      {"name": "S-C11 zero ducks", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["const b=pm.response.json(); pm.test('S-C11',()=>{pm.response.to.have.status(200); pm.expect(b.yield_are_kg).eq(50); pm.expect(b.density_are).eq(0); pm.expect(b.cost_duck_buy).eq(0); pm.expect(b.revenue_duck_all_sold_scenario).eq(0); pm.expect(b.cash_contribution_before_optional).eq(3000000);});"]}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"land_area_are\":10,\"duck_count\":0,\"rice_variety\":\"sertani\",\"planting_system\":\"jajar_legowo\",\"duck_age_days\":21}"}, "url": "{{base_url}}/api/v1/dss/simulate"}},
      {"name": "S-C12 invalid area", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["const b=pm.response.json(); pm.test('S-C12',()=>{pm.response.to.have.status(400); pm.expect(b.error.code).eq('validation_error');});"]}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"land_area_are\":0,\"duck_count\":20,\"rice_variety\":\"sertani\",\"planting_system\":\"jajar_legowo\",\"duck_age_days\":21}"}, "url": "{{base_url}}/api/v1/dss/simulate"}}
    ]},
    {"name": "Model C calendar and optional economics", "item": [
      {"name": "Calendar with planting date", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["const b=pm.response.json(); pm.test('calendar',()=>{pm.response.to.have.status(200); pm.expect(b.model_variant).eq('C_FARMER_GROUPED_LOCAL'); pm.expect(b.release_date_min).eq('2025-01-22'); pm.expect(b.release_date_max).eq('2025-01-31'); pm.expect(b.withdraw_date_min).eq('2025-02-26'); pm.expect(b.withdraw_date_max).eq('2025-03-02');});"]}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"land_area_are\":10,\"duck_count\":20,\"rice_variety\":\"sertani\",\"planting_system\":\"jajar_legowo\",\"duck_age_days\":21,\"planting_date\":\"2025-01-01\"}"}, "url": "{{base_url}}/api/v1/dss/simulate"}},
      {"name": "Optional feed and infrastructure", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["const b=pm.response.json(); pm.test('optional economics',()=>{pm.response.to.have.status(200); pm.expect(b.cost_feed_scenario).eq(100); pm.expect(b.cost_infra_cycle).eq(100); pm.expect(b.cash_contribution_after_optional).eq(3399800);});"]}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"land_area_are\":10,\"duck_count\":20,\"rice_variety\":\"sertani\",\"planting_system\":\"jajar_legowo\",\"duck_age_days\":21,\"c_feed_scenario\":100,\"c_jaring_purchase\":1000,\"n_jaring_cycles\":10}"}, "url": "{{base_url}}/api/v1/dss/simulate"}},
      {"name": "Invalid infrastructure denominator pairing", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["const b=pm.response.json(); pm.test('invalid optional pairing',()=>{pm.response.to.have.status(400); pm.expect(b.error.code).eq('validation_error');});"]}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"land_area_are\":10,\"duck_count\":20,\"rice_variety\":\"sertani\",\"planting_system\":\"jajar_legowo\",\"duck_age_days\":21,\"c_jaring_purchase\":1000}"}, "url": "{{base_url}}/api/v1/dss/simulate"}}
    ]},
    {"name": "Authenticated Model C history v4", "item": [
      {"name": "Register", "event": [{"listen": "prerequest", "script": {"type": "text/javascript", "exec": ["pm.collectionVariables.set('email', `model-c-${Date.now()}@example.test`);"]}}, {"listen": "test", "script": {"type": "text/javascript", "exec": ["const b=pm.response.json(); pm.test('register',()=>{pm.response.to.have.status(201); pm.expect(b.user.email).eq(pm.collectionVariables.get('email'));});"]}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"name\":\"Model C Postman\",\"email\":\"{{email}}\",\"password\":\"{{password}}\"}"}, "url": "{{base_url}}/api/v1/auth/register"}},
      {"name": "Login", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["const b=pm.response.json(); pm.test('login',()=>{pm.response.to.have.status(200); pm.expect(b.access_token).to.be.a('string').and.not.empty; pm.collectionVariables.set('token', b.access_token);});"]}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"email\":\"{{email}}\",\"password\":\"{{password}}\"}"}, "url": "{{base_url}}/api/v1/auth/login"}},
      {"name": "Persist v4 simulation", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["const b=pm.response.json(); pm.test('persist v4',()=>{pm.response.to.have.status(200); pm.expect(b.model_variant).eq('C_FARMER_GROUPED_LOCAL'); pm.collectionVariables.set('original_simulation', JSON.stringify(b));});"]}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{token}}"}], "body": {"mode": "raw", "raw": "{\"land_area_are\":10,\"duck_count\":20,\"rice_variety\":\"sertani\",\"planting_system\":\"jajar_legowo\",\"duck_age_days\":21}"}, "url": "{{base_url}}/api/v1/dss/simulate"}},
      {"name": "List v4 histories", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["const b=pm.response.json(); pm.test('list v4',()=>{pm.response.to.have.status(200); pm.expect(b.data).to.be.an('array').and.not.empty; pm.expect(b.data[0].schema_version).eq(4); pm.collectionVariables.set('history_id', b.data[0].id);});"]}}], "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}], "url": "{{base_url}}/api/v1/dss/histories"}},
      {"name": "Detail v4 history preserves original payload", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["const b=pm.response.json(); pm.test('detail v4',()=>{pm.response.to.have.status(200); pm.expect(b.model_variant).eq('C_FARMER_GROUPED_LOCAL'); pm.expect(b).deep.equal(JSON.parse(pm.collectionVariables.get('original_simulation')));});"]}}], "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}], "url": "{{base_url}}/api/v1/dss/histories/{{history_id}}"}},
      {"name": "Delete v4 history", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('delete v4',()=>{pm.response.to.have.status(200);});"]}}], "request": {"method": "DELETE", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}], "url": "{{base_url}}/api/v1/dss/histories/{{history_id}}"}},
      {"name": "Deleted v4 history is 404", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('deleted history returns 404',()=>{pm.response.to.have.status(404);});"]}}], "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}], "url": "{{base_url}}/api/v1/dss/histories/{{history_id}}"}}
    ]}
  ]
