      {"name": "S-C04 Jarwo d=8 warning", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["const b=pm.response.json(); pm.test('S-C04',()=>{pm.response.to.have.status(200); pm.expect(b.model_variant).eq('C_FARMER_GROUPED_LOCAL'); pm.expect(b.yield_are_kg).eq(50); pm.expect(b.density_are).eq(8); pm.expect(b.density_status).eq('WARNING_ABOVE_RECOMMENDED'); pm.expect(b.survival_risk).eq(null); pm.expect(b).not.have.property('N_survive');});"]}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"land_area_are\":10,\"duck_count\":80,\"rice_variety\":\"sertani\",\"planting_system\":\"jajar_legowo\",\"duck_age_days\":21}"}, "url": "{{base_url}}/api/v1/dss/simulate"}},
      {"name": "S-C05 Jarwo d>8 high risk", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["const b=pm.response.json(); pm.test('S-C05',()=>{pm.response.to.have.status(200); pm.expect(b.model_variant).eq('C_FARMER_GROUPED_LOCAL'); pm.expect(b.yield_are_kg).eq(50); pm.expect(b.density_are).eq(8.1); pm.expect(b.density_status).eq('HIGH_RISK'); pm.expect(b.survival_risk).eq('HIGH'); pm.expect(b.revenue_duck_all_sold_scenario).eq(null); pm.expect(b.cash_contribution_before_optional).eq(null); pm.expect(b.cash_contribution_after_optional).eq(null);});"]}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"land_area_are\":10,\"duck_count\":81,\"rice_variety\":\"sertani\",\"planting_system\":\"jajar_legowo\",\"duck_age_days\":21}"}, "url": "{{base_url}}/api/v1/dss/simulate"}},
