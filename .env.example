APP_NAME="Rice Duck DSS Backend"
APP_ENV="development"
APP_DEBUG=true
# Local marker only. Deployments should inject their release version.
APP_VERSION="0.0.0-dev"
API_V1_PREFIX="/api/v1"
HOST="127.0.0.1"
PORT=8000
DATABASE_PATH="data/rice_duck.db"
CORS_ALLOWED_ORIGINS="*"
# Required in every environment. Generate a unique high-entropy value; never
# copy a real secret into source control. Placeholder is rejected in production.
JWT_SECRET_KEY="replace-with-a-long-random-secret"
JWT_ACCESS_TOKEN_MINUTES=120
PASSWORD_HASH_ITERATIONS=600000
# Optional immutable code provenance attached to R2 responses/snapshots.
MODEL_COMMIT_SHA=""
